# Generate a real value with: npm run init   (or scripts/tunnel.sh, which does the same)
# Must be at least 24 characters. Read from the environment only; never from a request.
PROXY_API_KEY=replace-with-a-long-random-secret

# Loopback only. Any other value is refused at startup; put the tunnel in front instead.
HOST=127.0.0.1
PORT=8787

# Defaults applied when the model id carries no suffix (see README: model suffixes).
# DEFAULT_REASONING_EFFORT=medium
# DEFAULT_SERVICE_TIER=            # empty = unset; "priority" opts every request into fast mode

# Token refresh: "expired" (default) refreshes only once the access token is within
# REFRESH_SKEW_MS of expiry, after re-reading auth.json. "never" leaves refresh to the Codex CLI.
# CODEX_PROXY_REFRESH=expired
# REFRESH_SKEW_MS=30000

# Fingerprint. One user-agent is used for every upstream call.
# CODEX_CLIENT_VERSION=0.170.0
# CODEX_USER_AGENT=
# CODEX_ORIGINATOR=codex_cli_rs

# Models
# CODEX_PROXY_MODELS=gpt-5.5            # fixed allowlist; empty = live catalog
# CODEX_PROXY_MODEL_VARIANTS=low,high,xhigh

# Quota line in the log (5h and weekly windows). Off by default; at most once per interval.
# QUOTA_LOG=0
# QUOTA_LOG_INTERVAL_MS=300000

# Paths (defaults: $CODEX_HOME or ~/.codex)
# CODEX_HOME=
# CODEX_AUTH_FILE=
# CODEX_MODELS_CACHE_FILE=

# Limits
# MAX_CONCURRENT_REQUESTS=0
# MAX_REQUEST_BYTES=20971520
# REQUEST_TIMEOUT_MS=900000
